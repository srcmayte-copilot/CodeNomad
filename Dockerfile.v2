# CodeNomad v2 Server
FROM node:20-alpine AS base

# Install dependencies only when needed
FROM base AS deps
WORKDIR /app

# Copy workspace configuration
COPY package.json package-lock.json ./
COPY packages/v2-core/package.json ./packages/v2-core/
COPY packages/v2-server/package.json ./packages/v2-server/
COPY packages/v2-adapter-opencode/package.json ./packages/v2-adapter-opencode/

# Install dependencies
RUN npm ci

# Build stage
FROM base AS builder
WORKDIR /app

# Copy dependencies
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/v2-core/node_modules ./packages/v2-core/node_modules
COPY --from=deps /app/packages/v2-server/node_modules ./packages/v2-server/node_modules
COPY --from=deps /app/packages/v2-adapter-opencode/node_modules ./packages/v2-adapter-opencode/node_modules

# Copy source code
COPY packages/v2-core ./packages/v2-core
COPY packages/v2-server ./packages/v2-server
COPY packages/v2-adapter-opencode ./packages/v2-adapter-opencode
COPY package.json package-lock.json ./

# Build packages
RUN cd packages/v2-core && npm run build
RUN cd packages/v2-adapter-opencode && npm run build  
RUN cd packages/v2-server && npm run build

# Production stage
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production

# Create non-root user
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 codenomad

# Copy built application
COPY --from=builder --chown=codenomad:nodejs /app/packages/v2-core/dist ./packages/v2-core/dist
COPY --from=builder --chown=codenomad:nodejs /app/packages/v2-core/package.json ./packages/v2-core/
COPY --from=builder --chown=codenomad:nodejs /app/packages/v2-adapter-opencode/dist ./packages/v2-adapter-opencode/dist
COPY --from=builder --chown=codenomad:nodejs /app/packages/v2-adapter-opencode/package.json ./packages/v2-adapter-opencode/
COPY --from=builder --chown=codenomad:nodejs /app/packages/v2-server/dist ./packages/v2-server/dist
COPY --from=builder --chown=codenomad:nodejs /app/packages/v2-server/package.json ./packages/v2-server/
COPY --from=builder --chown=codenomad:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=codenomad:nodejs /app/package.json ./

# Create data directory
RUN mkdir -p /app/data && chown codenomad:nodejs /app/data

USER codenomad

# Expose port
EXPOSE 3100

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3100/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Start server
CMD ["node", "packages/v2-server/dist/index.js"]
